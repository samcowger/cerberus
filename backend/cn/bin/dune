(executable
 (name main)
 (public_name cn)
 (flags
  (:standard -w -37 -w -27 -open Monomorphic.Int))
 (modes exe)
 (package cn)
 (libraries
  cmdliner
  cn
  str
  unix
  z3
  monomorphic
  result
  cerb_frontend
  cerb_backend
  mem_concrete
  menhirLib
  cerb_util
  ocamlgraph))

; There is already a Version in Cerb_frontend, but if new commits only require
; rebuilding the CN backend that module will be out of date.
; So we add a CN specific version.

(rule
 (targets cn_version.ml)
 (deps (universe))
 (action
  (with-stdout-to
   cn_version.ml
   (run ocaml -I +unix unix.cma %{dep:../../../tools/gen_version.ml}))))
